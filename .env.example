# Copie para .env (que é ignorado pelo git) ou use os Secrets do Colab.
# NUNCA coloque chaves no código nem no notebook.

# Backend do modelo: fake | qwen_local | anthropic | openai_compat
FICHA_MODEL_BACKEND=fake
FICHA_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# Chaves (opcionais — só para backend por API)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Reprodutibilidade
FICHA_SEED=42
FICHA_TEMPERATURE=0.0

# Premissa de preço (USD por milhão de tokens) — fica visível junto do resultado.
# Padrão: tabela pública do Claude Sonnet 4.5 em 2026-09 (ajuste e declare no relatório).
FICHA_PRICE_INPUT_PER_MTOK=3.0
FICHA_PRICE_OUTPUT_PER_MTOK=15.0
